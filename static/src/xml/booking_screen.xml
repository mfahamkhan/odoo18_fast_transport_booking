<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="transport.booking.screen" owl="1">
        <div class="o_transport_booking_screen o_form_view o_form_sheet_bg" style="padding: 24px; background: #f8f9fa; height: 100vh;">
            <div class="o_form_sheet" style="max-width: 800px; margin: 0 auto;">
                <h2 class="mb-4 text-center">🚌 Fast Transport Booking</h2>

                <div class="mb-3">
                    <label class="form-label">Route </label>
                    <select class="form-select" t-on-change="onRouteChange">
                        <option value="">— Select Route —</option>
                        <t t-foreach="state.routes" t-as="route" t-key="route.id">
                            <option t-att-value="route.id" t-att-selected="state.route_id == route.id">
                                <t t-esc="route.name"/>
                            </option>
                        </t>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Vehicle (Fleet Vehicle)</label>
                    <select class="form-select" t-on-change="onVehicleChange">
                        <option value="">— Select Vehicle —</option>
                        <t t-foreach="state.vehicles" t-as="vehicle" t-key="vehicle.id">
                            <option t-att-value="vehicle.id" t-att-selected="state.vehicle_id == vehicle.id">
                                <t t-esc="vehicle.name"/> (Cap:<t t-esc="vehicle.capacity"/>)
                            </option>
                        </t>
                    </select>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Seats</label>
                        <input type="number" class="form-control" t-model.number="state.seats" min="1"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Amount</label>
                        <input type="number" step="0.01" class="form-control" t-model.number="state.amount" min="0"/>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Customer Name</label>
                    <input type="text" class="form-control" t-model="state.customer_name" placeholder="Full name"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Booking Date</label>
                    <input type="date" class="form-control" t-model="state.booking_date"/>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary btn-lg" t-on-click="onConfirm" t-att-disabled="!canConfirm">
                         Confirm Booking
                    </button>
                </div>

                <div t-if="state.feedback" class="mt-3 alert" t-att-class="state.feedback.type == 'success' ? 'alert-success' : 'alert-danger'">
                    <t t-esc="state.feedback.message"/>
                </div>
            </div>
        </div>
    </t>
</templates>
